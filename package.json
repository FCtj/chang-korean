{
  "name": "chang-korean",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "라오스·태국 학습자를 위한 그림·소리 한국어 단어 앱 (MVP)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build --mode single && node scripts/make-artifact.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/check-words.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@fontsource/fredoka": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "5.9",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
